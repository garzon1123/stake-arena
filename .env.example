# ─────────────────────────────────────────────────────────────
# STAKE Arena — DEMO MODE. Devnet / localnet test tokens only.
# There is intentionally no mainnet or real-money configuration.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8787
# Public origin of the web app (CORS, cookies, sign-in message URI)
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://localhost:5432/stake_arena

# devnet | localnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional; derived from SOLANA_RPC_URL when omitted
# SOLANA_WS_URL=wss://api.devnet.solana.com

PROGRAM_ID=4CGHpkEjVe6PAZC5V2cpNH2u1kakXQUxru4CSpnarCZL
# Created by `npm run chain:setup`
TEST_MINT=

# Server-only secrets: JSON byte array or path to a Solana CLI keypair file.
# NEVER expose these to the frontend or commit them.
ADJUDICATOR_KEYPAIR=keys/adjudicator.json
MINT_AUTHORITY_KEYPAIR=keys/mint-authority.json
FAUCET_AMOUNT=100

# Wallet Standard chain id used by the web app (solana:devnet | solana:localnet)
VITE_SOLANA_CHAIN=solana:devnet
